{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist"
  },
  // test/ está incluido a propósito: `npm run typecheck` valida también los
  // tests (los `satisfies` del contract test dependen de esto). tsup compila
  // solo desde sus entries (src/), así que esto no afecta el build.
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "examples"]
}
